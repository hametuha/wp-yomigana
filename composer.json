{
	"name": "fumikito/wp-yomigana",
	"description": "A WordPress plugin for ruby tag.",
	"license": "GPL-3.0-or-later",
	"scripts": {
		"lint": "phpcs --standard=phpcs.ruleset.xml",
		"fix": "phpcbf --standard=phpcs.ruleset.xml",
		"phpstan": "phpstan analyse --memory-limit=1G"
	},
	"authors": [
		{
			"name": "Takahashi Fumiki",
			"email": "takahashi.fumiki@hametuha.co.jp"
		}
	],
	"minimum-stability": "stable",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.0",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wordpress-stubs": "^6.9"
	},
	"autoload": {
		"psr-0": {
			"Hametuha\\Yomigana": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4"
		}
	}
}

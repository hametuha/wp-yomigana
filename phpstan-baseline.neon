parameters:
	ignoreErrors:
		-
			message: '#^Found usage of constant DOING_AJAX\. Use wp_doing_ajax\(\) instead\.$#'
			identifier: phpstanWP.wpConstant.fetch
			count: 1
			path: src/Hametuha/Yomigana/Admin.php

		-
			message: '#^Method Hametuha\\Yomigana\\Bootstrap\:\:__call\(\) should return array but return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: src/Hametuha/Yomigana/Bootstrap.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: src/Hametuha/Yomigana/Pattern/Application.php

		-
			message: '#^Method Hametuha\\Yomigana\\Pattern\\Application\:\:__get\(\) should return null but returns array\<mixed\>\.$#'
			identifier: return.type
			count: 1
			path: src/Hametuha/Yomigana/Pattern/Application.php

		-
			message: '#^Method Hametuha\\Yomigana\\Pattern\\Application\:\:__get\(\) should return null but returns string\.$#'
			identifier: return.type
			count: 2
			path: src/Hametuha/Yomigana/Pattern/Application.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 4
			path: src/Hametuha/Yomigana/Pattern/Application.php

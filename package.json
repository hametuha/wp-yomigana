{
  "name": "wp-yomigana",
  "private": true,
  "homepage": "https://wordpress.org/plugins/wp-yomigana/",
  "description": "Add ruby tag and some inline tags to WordPress editors.",
  "scripts": {
    "start": "wp-env start",
    "stop": "wp-env stop",
    "env": "wp-env",
    "cli": "wp-env run cli wp",
    "test": "wp-env run tests-cli --env-cwd=wp-content/plugins/wp-yomigana vendor/bin/phpunit -c phpunit.xml.dist",
    "package": "npm run build:css && npm run build:js",
    "build:js": "wp-scripts build wp-yomigana-gutenberg=./assets/js/src/wp-yomigana-gutenberg.jsx definition-list=./assets/js/src/definition-list.jsx definition-term=./assets/js/src/definition-term.jsx definition-description=./assets/js/src/definition-description.jsx editor_plugin=./assets/js/src/editor_plugin.js editor-helper=./assets/js/src/editor-helper.js --output-path=assets/js/dist",
    "build:css": "sass ./assets/scss/:./assets/css/ --style=compressed --no-source-map && postcss ./assets/css/*.css --use autoprefixer --replace --no-map",
    "watch": "wp-scripts start wp-yomigana-gutenberg=./assets/js/src/wp-yomigana-gutenberg.jsx definition-list=./assets/js/src/definition-list.jsx definition-term=./assets/js/src/definition-term.jsx definition-description=./assets/js/src/definition-description.jsx editor_plugin=./assets/js/src/editor_plugin.js editor-helper=./assets/js/src/editor-helper.js --output-path=assets/js/dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hametuha/wp-yomigana.git"
  },
  "author": "Hametuha inc.",
  "license": "GPL-3.0-or-later",
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "devDependencies": {
    "@wordpress/browserslist-config": "^6.0.0",
    "@wordpress/env": "^11.16.0",
    "@wordpress/scripts": "^36.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postcss-cli": "^12.0.0",
    "sass": "^1.83.0"
  }
}
